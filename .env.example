# Only two variables are needed. Both are for sending the drafted email to YOUR OWN Gmail inbox.
# Without them the app still researches everything and shows the drafts; it just doesn't send.

# The Gmail address that should receive the drafts (it also sends them, to itself).
GMAIL_USER_EMAIL=

# A 16-character Google "App password" (NOT your normal Gmail password).
# Create one at https://myaccount.google.com/apppasswords (needs 2-Step Verification on).
GMAIL_APP_PASSWORD=

# Optional
# MAX_DOMAINS_PER_JOB=10
# AUTO_SEND_TO_SELF=true
