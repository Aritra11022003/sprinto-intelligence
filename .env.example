# Email is the only configuration. It sends the drafted email to YOUR OWN inbox. Both options are free.
# Without any of these the app still researches everything and shows the drafts; it just doesn't send.

# Your inbox: the ONLY address the app will ever email (used by both options).
GMAIL_USER_EMAIL=

# Option A (preferred): Gmail. A 16-character Google "App password", NOT your normal password.
# Create one at https://myaccount.google.com/apppasswords (needs 2-Step Verification on).
GMAIL_APP_PASSWORD=

# Option B (backup, used only if GMAIL_APP_PASSWORD is empty): Resend, free tier (3,000 emails/month).
# Sign up at https://resend.com with the SAME email as GMAIL_USER_EMAIL, then create an API key.
RESEND_API_KEY=
# Optional: a sender on a domain you verified in Resend. Default: onboarding@resend.dev
# RESEND_FROM=

# Optional
# EMAIL_PROVIDER=gmail        # force "gmail" or "resend"
# MAX_DOMAINS_PER_JOB=10
# AUTO_SEND_TO_SELF=true
